# shared
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://skillescrow:skillescrow@localhost:5432/skillescrow
REDIS_URL=redis://localhost:6379
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
BOUNTY_CONTRACT_ID=CCEKBPYCWKNTXIQLXJHVAF7RYGUZZ6MITA7VVJBOK5BHXUO44ELZ4F4V
# api
# Protected monitoring scrape endpoint: generate a secret (minimum 32 characters).
# No token => /metrics returns 503; never put this token in a URL.
# METRICS_TOKEN=
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-me-32-bytes-minimum-change-me
CSRF_SECRET=change-me-32-bytes-minimum-change-me
GITHUB_WEBHOOK_SECRET=change-me
# Behind a reverse proxy (Render, Vercel, nginx): how many proxy hops to trust for X-Forwarded-For (e.g. 1) or a
# list of proxy IPs/CIDRs (e.g. 10.0.0.0/8). Needed so rate limits are per real client, not per proxy.
# Leave unset when the API is reached directly. "true" and 0.0.0.0/0 are rejected: they let clients spoof their IP.
# TRUST_PROXY=1
# not yet wired: GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_CLIENT_ID/SECRET, RELAYER_SECRET, ANTHROPIC_API_KEY

# --- GitHub App (docs/GITHUB_APP.md): set all five or none ---
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=skillescrow-staging
# GITHUB_CLIENT_ID=Iv1.xxxxxxxx
# GITHUB_CLIENT_SECRET=
# For the private key keep the PEM on one line with literal \n, or in quotes across lines:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- AI review (off unless a key is set) ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_MAX_REVIEWS_PER_PR_PER_DAY=5
# AI_MAX_REVIEWS_PER_REPO_PER_DAY=50
# --- Relayer (testnet only; refused on mainnet) ---
# RELAYER_SECRET=
# ALERT_WEBHOOK_URL=

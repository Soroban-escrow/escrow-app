generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  githubId       BigInt    @unique
  /// Case-insensitive uniqueness is enforced by the raw SQL index "User_githubLogin_lower_key".
  githubLogin    String
  avatarUrl      String?
  wallet         String?   @unique
  walletLinkedAt DateTime?
  isAdmin        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  challenges     WalletChallenge[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model WalletChallenge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  address   String
  message   String
  nonce     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  @@index([userId])
}

model Installation {
  id           BigInt    @id
  accountLogin String
  accountType  String
  suspendedAt  DateTime?
  createdAt    DateTime  @default(now())
  repos        Repo[]
}

model Repo {
  id             BigInt       @id
  installationId BigInt
  installation   Installation @relation(fields: [installationId], references: [id])
  fullName       String
  private        Boolean
  /// false once GitHub reports the repo removed from the installation; rows are kept because bounties reference them
  active         Boolean      @default(true)
  bounties       Bounty[]
  @@index([installationId])
}

model FundingIntent {
  id           String    @id
  repoId       BigInt
  issueNumber  Int
  requestedBy  BigInt
  token        String
  amount       Decimal   @db.Decimal(39, 0)
  durationDays Int
  commentId    BigInt
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  submissions  FundingSubmission[]
  @@index([repoId, issueNumber])
}

/// Binds a submitted funding transaction to the intent that authorised it. The indexer uses the
/// tx hash to attribute a funded event, so equal-amount intents from different maintainers cannot
/// be swapped by the fuzzy match.
model FundingSubmission {
  id        String        @id @default(cuid())
  intentId  String
  txHash    String        @unique
  createdAt DateTime      @default(now())
  intent    FundingIntent @relation(fields: [intentId], references: [id])
  @@index([intentId])
}

enum BountyStatus {
  OPEN
  RELEASED
  REFUNDED
  DISPUTED
  RESOLVED
}

model Bounty {
  id                 BigInt       @id
  repoId             BigInt
  repo               Repo         @relation(fields: [repoId], references: [id])
  issueNumber        Int
  issueTitle         String
  issueUrl           String
  criteria           String[]
  maintainer         String
  maintainerGithubId BigInt?
  token              String
  amount             Decimal      @db.Decimal(39, 0)
  feeBps             Int
  deadline           DateTime
  relayerAllowed     Boolean
  status             BountyStatus
  winnerAddress      String?
  winnerGithubId     BigInt?
  fundTx             String
  closeTx            String?
  cardCommentId      BigInt?
  lastEventId        String?
  createdAt          DateTime
  updatedAt          DateTime     @updatedAt
  prs                PullRequestBounty[]
  payouts            Payout[]
  disputes           Dispute[]
  @@index([repoId, issueNumber])
  @@index([status])
  @@index([maintainer])
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

model PullRequest {
  id             BigInt           @id
  number         Int
  authorGithubId BigInt
  authorLogin    String
  headSha        String
  state          PullRequestState
  mergedAt       DateTime?
  diffHash       String?
  reviews        AiReview[]
  bounties       PullRequestBounty[]
}

/// A PR can close several bountied issues; each link is one (PR, bounty) pair.
model PullRequestBounty {
  prId     BigInt
  bountyId BigInt
  pr       PullRequest @relation(fields: [prId], references: [id])
  bounty   Bounty      @relation(fields: [bountyId], references: [id])
  @@id([prId, bountyId])
  @@index([bountyId])
}

model AiReview {
  id           String      @id @default(cuid())
  prId         BigInt
  pr           PullRequest @relation(fields: [prId], references: [id])
  headSha      String
  model        String
  verdict      String
  score        Int
  result       Json
  flags        String[]
  inputTokens  Int
  outputTokens Int
  commentId    BigInt?
  createdAt    DateTime    @default(now())
  @@unique([prId, headSha])
  @@index([createdAt])
}

enum PayoutStatus {
  PENDING_WALLET
  QUEUED
  SUBMITTED
  CONFIRMED
  FAILED
  AWAITING_MAINTAINER
}

model Payout {
  id             String       @id @default(cuid())
  bountyId       BigInt
  bounty         Bounty       @relation(fields: [bountyId], references: [id])
  prNumber       Int
  winnerGithubId BigInt
  winnerAddress  String?
  status         PayoutStatus
  idempotencyKey String       @unique
  txHash         String?
  attempts       Int          @default(0)
  /** When a transient failure may be retried; persisted so a restart does not reset backoff. */
  nextAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([nextAttemptAt])
  @@index([status, updatedAt])
  @@index([winnerGithubId])
}

enum DisputeStatus {
  REQUESTED
  OPENED_ONCHAIN
  REJECTED
  RESOLVED
}

model Dispute {
  id               String        @id @default(cuid())
  bountyId         BigInt
  bounty           Bounty        @relation(fields: [bountyId], references: [id])
  openedByGithubId BigInt
  openedByLogin    String?
  reason           String
  evidence         Json
  status           DisputeStatus
  resolutionNote   String?
  /// The admin's proposed resolution, stored when the unsigned XDR is built. It only becomes
  /// resolutionNote once the indexer observes an on-chain resolve with the same winner and split.
  pendingWinner    String?
  pendingWinnerBps Int?
  pendingNote      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([status])
  @@index([status, createdAt])
  @@index([bountyId])
}

model WebhookDelivery {
  id          String    @id
  event       String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?
}

model IndexerCursor {
  id        String   @id
  cursor    String?
  ledger    Int
  updatedAt DateTime @updatedAt
}

/// A funded event for a repo we do not track yet. Kept so a late installation can replay it
/// instead of losing the bounty when the cursor has already moved past the event.
model UntrackedFundEvent {
  id        BigInt   @id // bounty id from the fund event
  repoId    BigInt
  payload   String   // serialized ChainEvent + EventMeta (bigints tagged so JSON round-trips)
  createdAt DateTime @default(now())
  @@index([repoId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String
  data      Json
  createdAt DateTime @default(now())
  @@index([action, target])
}
